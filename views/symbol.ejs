<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title:title}) %>
  <body>
    <%- include("./partials/header", {title:title}) %>
    <a href="/">Go back to homepage</a>
    <a href="/symbols">Explore symbols</a>
    <button
      class="delete-btn"
      data-action="deleteSymbol"
      data-id="<%= symbol.id %>"
    >
      Delete symbol
    </button>
    <button
      class="edit-btn"
      data-action="toggleForm"
      data-id="editForm-<%= symbol.id %>"
    >
      Edit symbol
    </button>

    <% if (locals.visibleForm === `editForm-${symbol.id}`) { %>
    <%- include("./partials/editSymbolForm", {symbol: symbol, visible: true, errors: errors}) %>
    <% } else { %>
    <%- include("./partials/editSymbolForm", {symbol: symbol, visible: false, errors: false}) %>
    <% } %>

    <div class="symbol-block">
      <% if (gods) { %>
      <h3>Gods associated with this symbol:</h3>
      <ul>
        <% gods.forEach((god) => { %>
        <li>
          <a class="symbol" href="/god/<%= god.id %>/<%= god.name %>">
            <%= god.name %> (<%= god.p_name %>)
          </a>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>

    <%- include("./partials/footer") %>
  </body>
</html>
