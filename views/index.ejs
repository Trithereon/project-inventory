<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title:title}) %>
  <body>
    <%- include("./partials/header", {title:title}) %>

    <% pantheons.forEach((pantheon)=>{ %>
    <div>
      <h3 class="name">
        <a href="/pantheon/<%= pantheon.name.toLowerCase() %>/view"
          ><%= pantheon.name %></a
        >
      </h3>
      <small class="origin"><%= pantheon.origin %></small>
      <div class="description"><%= pantheon.description %></div>
    </div>
    <% }) %>

    <%- include("./partials/footer") %>
  </body>
</html>
