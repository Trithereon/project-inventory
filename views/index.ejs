<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title:title}) %>
  <body>
    <%- include("./partials/header", {title:title}) %>

    <button
      class="create-btn"
      data-id="pantheonCreate"
      data-action="toggleForm"
    >
      Create new pantheon
    </button>
    <form id="pantheonCreate" action="/pantheon/create" method="POST">
      <div>
        <label for="name">Name: </label>
        <input type="text" id="name" name="name" placeholder="e.g. Roman" />
      </div>
      <div>
        <label for="origin">Region of origin: </label>
        <input
          type="text"
          id="origin"
          name="origin"
          placeholder="e.g. Rome, 2000 BC"
        />
      </div>
      <div>
        <label for="description">Description: </label>
        <textarea
          id="description"
          name="description"
          placeholder="A brief summary"
          rows="9"
          cols="45"
        ></textarea>
      </div>
      <button type="submit">Create new pantheon</button>
    </form>

    <% pantheons.forEach((pantheon)=>{ %>
    <div class="pantheon-block">
      <h3 class="name">
        <a href="/pantheon/<%= pantheon.id %>/<%= pantheon.name %>">
          <%= pantheon.name %>
        </a>
      </h3>
      <small class="origin"><%= pantheon.origin %></small>
      <div class="description"><%= pantheon.description %></div>
      <button
        class="delete-btn"
        data-action="deletePantheon"
        data-id="<%= pantheon.id %>"
      >
        Delete pantheon
      </button>
      <button
        class="edit-btn"
        data-action="toggleForm"
        data-id="editForm-<%= pantheon.id %>"
      >
        Edit pantheon
      </button>

      <% if (locals.visibleForm === `editForm-${pantheon.id}`) { %>
      <%- include("./partials/editPantheonForm", {pantheon: pantheon, visible: true, errors: errors}) %>
      <% } else { %>
      <%- include("./partials/editPantheonForm", {pantheon: pantheon, visible: false, errors: false}) %>
      <% } %>
    </div>
    <% }) %>

    <a href="/domains">Domains</a>
    <a href="/symbols">Symbols</a>

    <%- include("./partials/footer") %>
  </body>
</html>
