<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title:title}) %>
  <body>
    <%- include("./partials/header", {title:title}) %>

    <script>
      function toggleForm() {
        const form = document.querySelector("form");
        return form.classList.toggle("visible");
      }
    </script>

    <a href="/">Go back to homepage</a>

    <button class="create-btn" onclick="toggleForm()">Create new god</button>
    <form action="/god/create" method="POST">
      <div>
        <label for="name">Name: </label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="e.g. Apollo"
          required
        />
      </div>
      <div>
        <label for="pantheon_id">Pantheon: </label>
        <select id="pantheon_id" name="pantheon_id" required>
          <option value="">-</option>
          <% pantheons.forEach((pantheon) => { %>
          <option value="<%= pantheon.id %>"><%= pantheon.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="gender">Gender: </label>
        <select id="gender" name="gender">
          <option value="">-</option>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
          <option value="Both">Both</option>
        </select>
      </div>
      <div>
        <label for="status">Status: </label>
        <select id="status" name="status">
          <option value="">-</option>
          <option value="Major">Major</option>
          <option value="Minor">Minor</option>
        </select>
      </div>
      <div>
        <label for="description">Description: </label>
        <textarea
          id="description"
          name="description"
          placeholder="A brief summary"
        ></textarea>
      </div>
      <div>
        <label for="img_url">Image URL: </label>
        <input
          name="img_url"
          id="img_url"
          type="url"
          placeholder="Enter a valid URL"
        />
      </div>
      <button type="submit">Submit</button>
    </form>

    <% gods.forEach((god) => { %>
    <div class="god-block">
      <h3>
        <a href="/god/<%= god.id %>/<%= god.name %>"><%= god.name %></a>
      </h3>
      <small>
        <%= god.gender || "Gender unknown" %>,
        <%= god.status || "Status unknown" %>
      </small>
      <% if (god.img_url) { %>
      <img
        src="<%= god.img_url %>"
        alt="Image of
      <%= god.name %>"
      />
      <% } %>
      <button
        class="delete-btn"
        data-action="deleteGod"
        data-id="<%= god.id %>"
      >
        Delete god
      </button>
      <button class="edit-btn" data-action="editGod" data-id="<%= god.id %>">
        Edit god
      </button>
    </div>
    <% }) %>

    <%- include("./partials/footer") %>
  </body>
</html>
