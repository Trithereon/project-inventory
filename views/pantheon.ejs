<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title:title}) %>
  <body>
    <%- include("./partials/header", {title:title}) %>

    <% gods.forEach((god)=>{ %>
    <div class="god-block">
      <h3>
        <a href="/"><%= god.name %></a>
      </h3>
      <small>
        <%= god.gender %>,
        <%= god.status %></small
      >
      <div class="description"><%= god.description %></div>
      <img src="<%= god.img_url %>" alt="Image of <%= god.name %>" />
    </div>
    <% }) %>

    <%- include("./partials/footer") %>
  </body>
</html>
