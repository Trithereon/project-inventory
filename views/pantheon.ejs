<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title:title}) %>
  <body>
    <%- include("./partials/header", {title:title}) %>

    <a href="/">Go back to homepage</a>

    <button class="create-btn" data-action="toggleForm" data-id="createGodForm">
      Create new god
    </button>

    <% if (locals.visibleForm === "createGodForm") { %>
    <%- include("./partials/createGodForm", {domains: domains, data: data, visible: true, errors: errors}) %>
    <% } else { %>
    <%- include("./partials/createGodForm", {domains: domains, data: false, visible: false, errors: false}) %>
    <% } %>
    <div class="main-content">
      <% gods.forEach((god) => { %>
      <div class="god-block">
        <h2>
          <a href="/god/<%= god.id %>/<%= god.name %>"><%= god.name %></a>
        </h2>
        <small>
          <%= god.gender || "Gender unknown" %>,
          <%= god.status || "Status unknown" %>
        </small>
        <% if (god.img_url) { %>
        <img src="<%= god.img_url %>" alt="Image of <%= god.name %>" />
        <% } %>
      </div>
      <% }) %>
    </div>
    <%- include("./partials/footer") %>
  </body>
</html>
