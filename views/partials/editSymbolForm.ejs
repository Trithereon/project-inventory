<form
  id="editForm-<%= symbol.id %>"
  action="/symbol/edit/<%= symbol.id %>?_method=PUT"
  method="POST"
  data-form="edit"
  class="<%= visible ? 'visible' : '' %>"
  <%= errors ? "data-errored" : "" %>
>
<%- include("./validationErrors") %>

  <div class="input-line">
    <label for="name">Name: </label>
    <input
      type="text"
      id="symbol"
      name="symbol"
      placeholder="e.g. Spear"
      value="<%= locals.data ? locals.data.symbol : symbol.symbol %>"
      required
    />
  </div>
  <button type="submit">Submit Changes</button>
</form>
