<form
  id="createGodForm"
  action="/god/create"
  method="POST"
  class="<%= visible ? 'visible' : ''%>"
  <%= errors ? "data-errored" : "" %>
>
  <%- include("./validationErrors") %>

  <div class="input-line">
    <label for="name">Name: </label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="e.g. Apollo"
      required
      value="<%= locals.data ? data.name : '' %>"
    />
  </div>
  <div class="input-line">
    <label for="pantheon_id">Pantheon: </label>
    <select id="pantheon_id" name="pantheon_id" required>
      <option value="">-</option>
      <% pantheons.forEach((pantheon) => { %>
      <option value="<%= pantheon.id %>"><%= pantheon.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="input-line">
    <label for="gender">Gender: </label>
    <select id="gender" name="gender">
      <option value="">-</option>
      <option value="Male">Male</option>
      <option value="Female">Female</option>
      <option value="Both">Both</option>
    </select>
  </div>
  <div class="input-line">
    <label for="status">Status: </label>
    <select id="status" name="status">
      <option value="">-</option>
      <option value="Major">Major</option>
      <option value="Minor">Minor</option>
    </select>
  </div>
  <div class="input-line">
    <label for="description">Description: </label>
    <textarea
      id="description"
      name="description"
      placeholder="A brief summary"
    ><%= locals.data ? data.description : '' %></textarea>
  </div>
  <div class="input-line">
    <label for="img_url">Image URL: </label>
    <input
      name="img_url"
      id="img_url"
      type="url"
      placeholder="Enter a valid URL"
    />
  </div>
  <div class="input-line">
    <label for="domains">Domain(s): </label>
    <select name="domains" id="domains" multiple size="6">
      <% domains.forEach((d) => { %>
      <option value="<%= d.id %>"><%= d.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="input-line">
    <label for="symbols">Symbol(s): </label>
    <select name="symbols" id="symbols" multiple size="6">
      <% symbols.forEach((s) => { %>
      <option value="<%= s.id %>"><%= s.symbol %></option>
      <% }) %>
    </select>
  </div>
  <button type="submit">Submit</button>
</form>
