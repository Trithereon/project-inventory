<form
  id="editForm-<%= domain.id %>"
  action="/domain/edit/<%= domain.id %>?_method=PUT"
  method="POST"
  data-form="edit"
  class="<%= visible ? 'visible' : '' %>"
  <%= errors ? "data-errored" : "" %>
>
<%- include("./validationErrors") %>

  <div class="input-line">
    <label for="name">Name: </label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="e.g. Sun"
      value="<%= locals.data ? locals.data.name : domain.name %>"
      required
    />
  </div>
  <button type="submit">Submit Changes</button>
</form>
