<form
  id="domainCreate"
  action="/domain/create"
  method="POST"
  class="<%= visible ? 'visible' : ''%>"
  <%= errors ? "data-errored" : "" %>
>

<%- include("./validationErrors") %>

  <div class="input-line">
    <label for="name">Name: </label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="e.g. Sun"
      value="<%= locals.data ? locals.data.name : '' %>"
    />
  </div>
  <button type="submit">Submit</button>
</form>
