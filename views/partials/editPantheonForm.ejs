<form
  id="editForm-<%= pantheon.id %>"
  action="/pantheon/edit/<%= pantheon.id %>?_method=PUT"
  method="POST"
  data-form="edit"
  class="<%= visible ? 'visible' : '' %>"
>
  <%- include("./validationErrors") %>

  <div class="input-line">
    <label for="name">Name: </label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="e.g. Roman"
      value="<%= pantheon.name %>"
      required
    />
  </div>
  <div class="input-line">
    <label for="origin">Region of origin: </label>
    <input
      type="text"
      id="origin"
      name="origin"
      placeholder="e.g. Rome, 2000 BC"
      value="<%= pantheon.origin %>"
    />
  </div>
  <div class="input-line">
    <label for="description">Description: </label>
    <textarea
      id="description"
      name="description"
      placeholder="A brief summary"
      rows="10"
      cols="50"
    >
<%= pantheon.description %></textarea>
  </div>
  <button type="submit">Submit changes</button>
</form>
