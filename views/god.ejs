<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title:title}) %>
  <body>
    <%- include("./partials/header", {title:title}) %>
    <a href="/pantheon/<%= god.pantheon_id %>/<%= god.p_name %>">
      Go back to <%= god.p_name %> pantheon
    </a>
    <div class="god-block">
      <small>
        <%= god.gender || "Gender unknown" %>,
        <%= god.status || "Status unknown" %>
      </small>
      <div class="description"><%= god.description %></div>

      <% if (god.img_url) { %>
      <img src="<%= god.img_url %>" alt="Image of <%= god.name %>" />
      <% } %>
      <% if (symbols) { %>
      <h3>Symbols:</h3>
      <ul>
        <% symbols.forEach((symbol) => { %>
        <li>
          <a class="symbol" href="/symbol/<%= symbol.id %>/<%= symbol.symbol %>"
            ><%= symbol.symbol %></a
          >
        </li>
        <% }) %>
      </ul>
      <% } %>
      <% if (domains) { %>
      <h3>Domains:</h3>
      <ul>
        <% domains.forEach((domain) => { %>
        <li>
          <a class="domain" href="/domain/<%= domain.id %>/<%= domain.name %>">
            <%= domain.name %>
          </a>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>

    <%- include("./partials/footer") %>
  </body>
</html>
